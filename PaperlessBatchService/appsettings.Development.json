{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=paperless-db;Port=5432;Database=paperless;Username=paperless;Password=paperless123"
  },
  "BatchProcessing": {
    "InputFolder": "/app/batch/input",
    "ArchiveFolder": "/app/batch/archive",
    "ErrorFolder": "/app/batch/error",
    "FilePattern": "access_log_*.xml",
    "CronSchedule": "0 1 * * *",
    "IsEnabled": true,
    "MaxFilesPerBatch": 100,
    "MaxFileSizeBytes": 52428800
  }
}
